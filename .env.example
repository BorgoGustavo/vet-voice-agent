# Copy to .env and fill in. .env is gitignored, never commit it.
# Every script reads it through uv: uv run --env-file .env <script>

# LiveKit Cloud: Settings > API keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit Cloud: Settings > Project. Twilio sends calls to this address.
LIVEKIT_SIP_URI=sip:xxxxxxxx.sip.livekit.cloud
# LiveKit Cloud: Telephony > SIP trunks, the outbound trunk to Twilio. dial.py calls through it.
LIVEKIT_OUTBOUND_TRUNK_ID=ST_xxxxxxxx

# OpenAI: platform.openai.com > API keys
OPENAI_API_KEY=

# Twilio: console home, "Account Info"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number the agent answers.
CLINIC_NUMBER=+1
# A second number that only says "Recepção, um momento". Transfers land here.
RECEPTION_NUMBER=+1
# A number on this account the test robot calls from. Owned numbers need no caller ID verification.
ROBOT_NUMBER=+1
# Twilio: Elastic SIP Trunking > Trunks. LiveKit dials out through the termination domain with
# these credentials; the trunk's origination points at LIVEKIT_SIP_URI so CLINIC_NUMBER rings the agent.
TWILIO_TRUNK_DOMAIN=xxxxxxxx.pstn.twilio.com
TWILIO_TRUNK_USER=
TWILIO_TRUNK_PASSWORD=

# Supabase: Connect > Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
