# Copy to .env and fill in. .env is gitignored, never commit it.
# Every script reads it through uv: uv run --env-file .env <script>

# LiveKit Cloud: Settings > API keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit Cloud: Settings > Project. Twilio sends calls to this address.
LIVEKIT_SIP_URI=sip:xxxxxxxx.sip.livekit.cloud

# OpenAI: platform.openai.com > API keys
OPENAI_API_KEY=

# Twilio: console home, "Account Info"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number the agent answers.
CLINIC_NUMBER=+1
# A second number that only says "Recepção, um momento". Transfers land here.
RECEPTION_NUMBER=+1
# Your own phone, registered in Twilio as a Verified Caller ID. Test calls come from it.
TEST_CALLER_NUMBER=+55
# Twilio: Voice > SIP Domains. LiveKit's outbound trunk dials through it for the test calls.
TWILIO_SIP_DOMAIN=xxxxxxxx.sip.twilio.com
TWILIO_SIP_USER=
TWILIO_SIP_PASSWORD=

# Supabase: Connect > Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
